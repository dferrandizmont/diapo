        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"roll_id\" INTEGER NULL REFERENCES rolls (id) ON DELETE CASCADE, \"frame_number\" INTEGER NULL, \"film_id\" TEXT NOT NULL, \"format\" TEXT NOT NULL, \"lens\" TEXT NOT NULL, \"taken_at\" INTEGER NOT NULL, \"vault_path\" TEXT NULL, \"gallery_uri\" TEXT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"intensity\" REAL NOT NULL DEFAULT 1.0, \"overrides_json\" TEXT NULL);"
