          "sql": "CREATE TABLE IF NOT EXISTS \"rolls\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"film_id\" TEXT NOT NULL, \"length\" INTEGER NOT NULL, \"mode\" TEXT NOT NULL, \"develop_delay\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, \"develop_at\" INTEGER NULL, \"developed_at\" INTEGER NULL);"
