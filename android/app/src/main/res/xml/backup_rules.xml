<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and lower (android:fullBackupContent).
  Backups are off in the manifest (allowBackup="false"); these rules make
  sure that, if they are ever turned on, nothing of the app's private data leaves
  the device: the vault cannot be opened without this device's Keystore key,
  and the database and settings would point at files the new install cannot
  use.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
