{% extends 'base/layout.html.j2' %}
{% block content %}
<div class="wrap doc">
  <p class="crumbs"><a href="{{ route(lang) }}">{{ c.name }}</a><span aria-hidden="true"> / </span><span>{{ t.privacy }}</span></p>
  <h1>{{ t.privacy_full }}</h1>
  <p class="docmeta">{{ t.privacy_version }} <time datetime="{{ c.privacy_date }}">{{ c.privacy_date }}</time> · <a href="mailto:{{ contact_email }}">{{ contact_email }}</a></p>
  {% if policy_lang != lang %}<p class="privacy-fallback">{{ t.privacy_fallback.format(language=t.languages_inline[policy_lang]) }}</p>{% endif %}
  <article class="prose" lang="{{ policy_lang }}">{{ policy_html }}</article>
</div>
{% endblock %}
